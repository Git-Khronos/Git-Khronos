{
  "name": "desktop",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/desktop/src",
  "targets": {
    "graph-test-typecheck": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": { "command": "tsc --project tsconfig.graph-tests.json" }
    },
    "owned-process-test": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": { "command": "node --test tools/owned-command.test.mjs tools/run-validation.test.mjs tools/retest-changed.test.mjs tools/renderer-artifacts.test.mjs tools/compare-renderer-case-timings.test.mjs" }
    },
    "editor-recovery-test": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": { "command": "node --test tools/editor-draft-snapshots.test.mjs" }
    },
    "audit": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": { "command": "pnpm audit --audit-level low" }
    },
    "package-deb": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": { "command": "task package:deb" }
    },
    "package-ubuntu": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": { "command": "task --force package:ubuntu" }
    },
    "package-appimage": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": { "command": "task --force package:appimage" }
    },
    "package-test": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": { "command": "node --test tools/install-script.test.mjs tools/check-linux-appimage.test.mjs tools/check-debian-update-evidence.test.mjs tools/check-debian-candidate-run.test.mjs tools/package-deb.test.mjs tools/collect-rust-notices.test.mjs tools/prepare-rust-notices.test.mjs tools/prepare-frontend-notices.test.mjs tools/report-initial-renderer.test.mjs tools/report-installed-acceptance.test.mjs tools/run-focused-installed-acceptance.test.mjs" },
      "configurations": {
        "focused": { "command": "node --test" }
      }
    },
    "native-smoke": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": { "command": "python3 tools/native_acceptance.py --suite smoke --headless" }
    },
    "native-application-updates": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": { "command": "python3 tools/native_acceptance.py --suite application-updates --headless" }
