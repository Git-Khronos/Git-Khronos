    },
    "native-discard-deletion": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": { "command": "python3 tools/native_acceptance.py --suite discard-deletion --headless" }
    },
    "native-discard-stale-review": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": { "command": "python3 tools/native_acceptance.py --suite discard-stale-review --headless" }
    },
    "native-environment": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": { "command": "python3 tools/native_acceptance.py --suite environment --headless" }
    },
    "native-performance": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": { "command": "python3 tools/native_acceptance.py --suite performance --headless" }
    },
    "e2e": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": { "command": "playwright test" },
      "configurations": {
        "smoke": { "command": "playwright test --grep @daily-driver-smoke" },
        "worktrees": { "command": "playwright test 'e2e/renderer/(worktree-|branch-checkout-worktree|submodule-review)'" },
        "branch-checkout": { "command": "playwright test 'e2e/renderer/branch-checkout-worktree[.]spec[.]ts$'" },
        "sparse-checkout": { "command": "playwright test 'e2e/renderer/sparse-(checkout|left-paths)[.]spec[.]ts$'" },
        "repository-confirmations": { "command": "playwright test 'e2e/renderer/(accessibility-audit|commit-policy|confirmation-keyboard|force-destination-layout|push-sync|remote-cleanup-review-scope|repository-(confirmation|setup)-scope|sparse-(checkout|left-paths)|workspace|worktree-move)[.]spec[.]ts$'" },
        "history-confirmations": { "command": "playwright test 'e2e/renderer/(branch-panel-interactions|commit-action-menu|confirmation-keyboard|history-review-loading|mainline-replay|no-commit-replay|operation-recovery|ordered-revert|rebase-split|repository-confirmation-scope|workspace)[.]spec[.]ts$'" },
        "lfs": { "command": "playwright test 'e2e/renderer/lfs-(tracking|locks|prune)[.]spec[.]ts$'" },
        "submodules": { "command": "playwright test 'e2e/renderer/submodule-review[.]spec[.]ts$'" },
        "working-files": { "command": "playwright test 'e2e/renderer/(working-(tree|file|directory)|unstaged-summary|discard-recovery|editor-draft-recovery|file-tools)'" },
        "recaps": { "command": "playwright test 'e2e/renderer/unstaged-summary[.]spec[.]ts$'" },
        "editor": { "command": "playwright test 'e2e/renderer/(working-file-editor|editor-draft-recovery|file-tools)[.]spec[.]ts$'" },
        "discard": { "command": "playwright test 'e2e/renderer/(discard-recovery|working-tree-lifecycle)[.]spec[.]ts$'" },
        "branches": { "command": "playwright test 'e2e/renderer/(branch-|context-branch-|previous-branch|reference-actions)'" },
        "branch-workflows": { "command": "playwright test 'e2e/renderer/branch-workflows[.]spec[.]ts$'" },
        "reference-actions": { "command": "playwright test 'e2e/renderer/(reference-actions|reference-action-scope|deferred-action-scope)[.]spec[.]ts$'" },
        "stash": { "command": "playwright test 'e2e/renderer/(stash-|inline-stash-)'"},
        "transport": { "command": "playwright test 'e2e/renderer/(authentication[.-]|fetch-|pull-strategies|push-sync|remote-cleanup-review-scope)'" },
        "gitlab": { "command": "playwright test 'e2e/renderer/gitlab-'"},
        "graph": { "command": "playwright test 'e2e/renderer/(graph-|deferred-background-ui)' --grep-invert @exhaustive-layout" },
        "history": { "command": "playwright test 'e2e/renderer/(history-|blame-pages|operation-history-lifecycle)'" },
        "history-search": { "command": "playwright test 'e2e/renderer/history-search(-lifecycle)?[.]spec[.]ts$'" },
        "git-documentation": { "command": "playwright test 'e2e/renderer/git-documentation[.]spec[.]ts$'" },
        "workspace": { "command": "playwright test 'e2e/renderer/workspace([.-])'" },
        "menus": { "command": "playwright test 'e2e/renderer/(deferred-main-menu|workspace-menu)[.]spec[.]ts$'" },
        "keyboard": { "command": "playwright test 'e2e/renderer/(command-palette|keyboard-shortcuts|confirmation-keyboard|setup-dialog-keyboard)'" },
        "updates": { "command": "playwright test 'e2e/renderer/application-updates[.]spec[.]ts$'" }
      }
    },
    "e2e-quick": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "playwright test --grep-invert '@exhaustive-layout'"
      }
    },
    "e2e-webkit": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node tools/check-renderer-browser.mjs webkit && playwright test --project=webkit",
        "env": { "GIT_KHRONOS_RENDERER_WEBKIT": "1" }
      }
    },
    "archive-cache-test": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": { "command": "python3 -m unittest discover -s tools -p 'prune_local_build_caches_test.py'" }
    },
    "native-harness-test": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": { "command": "python3 -m unittest discover -s tools -p 'native_*_test.py'" }
    },
    "test-signing": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "cargo test -p git-khronos-git-core signing_ -- --ignored --test-threads=1"
      }
    },
    "test-ssh": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "cargo test -p git-khronos-desktop --test ssh_transport -- --ignored --test-threads=1"
      }
    },
    "test-lfs": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "commands": [
          "git lfs version",
          "cargo test -p git-khronos-git-core lfs_ -- --ignored --test-threads=1",
          "cargo test -p git-khronos-desktop --test authentication_transport lfs_ -- --ignored --test-threads=1"
        ],
        "parallel": false
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "defaultConfiguration": "production",
      "cache": true,
      "inputs": ["production", "^production", "{workspaceRoot}/angular.json", "{workspaceRoot}/tsconfig*.json", "{workspaceRoot}/pnpm-lock.yaml", "{workspaceRoot}/tools/check-production-renderer.mjs", "{workspaceRoot}/tools/report-initial-renderer.mjs"],
      "outputs": ["{options.output-path}"],
      "options": {
        "output-path": "dist/apps/desktop",
        "commands": [
          { "command": "ng build desktop", "forwardAllArgs": true },
          { "command": "node tools/check-production-renderer.mjs \"{args.output-path}/browser\"", "forwardAllArgs": false },
          { "command": "node tools/report-initial-renderer.mjs \"{args.output-path}\" --record --enforce-warning", "forwardAllArgs": false }
        ],
        "parallel": false
      },
      "configurations": {
        "production": {},
        "development": {
          "output-path": "dist/development/desktop",
          "commands": [{ "command": "ng build desktop --configuration development", "forwardAllArgs": true }]
        }
      }
    },
    "serve": { "executor": "nx:run-commands", "options": { "command": "ng serve desktop" } },
    "tauri-dev": {
      "executor": "nx:run-commands",
      "options": { "command": "tauri dev --config apps/desktop/src-tauri/tauri.conf.json" }
    },
    "tauri-build": {
      "executor": "nx:run-commands",
      "options": { "command": "tauri build --config apps/desktop/src-tauri/tauri.conf.json" }
    },
    "check": {
      "inputs": ["default", "^production", "rust", "{workspaceRoot}/angular.json", "{workspaceRoot}/tsconfig*.json", "{workspaceRoot}/pnpm-lock.yaml", "{workspaceRoot}/tools/report-renderer-css-tokens*.mjs", "{workspaceRoot}/tools/cli-entry.mjs"],
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "node --test tools/report-renderer-css-tokens.test.mjs && node tools/report-renderer-css-tokens.mjs --check",
          "cargo fmt --all -- --check",
          "ng build desktop --configuration development --output-path=dist/checks/desktop",
          "cargo check --workspace --all-targets",
          "cargo clippy --workspace --all-targets -- -D warnings"
        ],
        "parallel": false
      }
    },
    "test-authentication": {
      "cache": false,
      "executor": "nx:run-commands",
      "options": { "command": "cargo test --locked -p git-khronos-desktop --test authentication_transport" }
    },
    "git-core-unit-test": {
      "cache": false,
      "executor": "nx:run-commands",
      "options": { "command": "cargo test --locked -p git-khronos-git-core --lib --" }
    },
    "renderer-unit-test": {
      "cache": true,
      "inputs": ["default", "^production", "{workspaceRoot}/vitest.config.mts", "{workspaceRoot}/tsconfig*.json", "{workspaceRoot}/pnpm-lock.yaml", "{workspaceRoot}/tools/check-production-renderer.mjs"],
      "executor": "nx:run-commands",
      "options": { "command": "pnpm exec vitest run apps/desktop/src/app/*.spec.ts" },
      "configurations": {
        "focused": { "command": "pnpm exec vitest run --dir apps/desktop/src/app" }
      }
    },
    "test": {
      "dependsOn": ["graph-test-typecheck", "owned-process-test", "editor-recovery-test", "renderer-unit-test"],
      "inputs": ["default", "^production", "rust", "{workspaceRoot}/angular.json", "{workspaceRoot}/vitest.config.mts", "{workspaceRoot}/tsconfig*.json", "{workspaceRoot}/pnpm-lock.yaml", "{workspaceRoot}/tools/check-production-renderer.mjs"],
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "cargo test --workspace",
          "cargo test --locked -p git-khronos-desktop --example stage-debian-update"
        ],
        "parallel": false
      }
    }
  },
  "tags": ["type:app", "platform:desktop"]
}
