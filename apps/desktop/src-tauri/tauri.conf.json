{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Git Khronos",
  "version": "0.1.0",
  "identifier": "org.gitkhronos.desktop",
  "build": {
    "beforeDevCommand": "pnpm nx run desktop:serve -- --host 127.0.0.1",
    "devUrl": "http://127.0.0.1:4200",
    "beforeBuildCommand": "pnpm nx run desktop:build",
    "beforeBundleCommand": "node tools/prepare-linux-package.mjs",
    "frontendDist": "../../../dist/apps/desktop/browser"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; style-src-attr 'unsafe-inline'; img-src 'self' asset: data:; font-src 'self'; connect-src ipc: http://ipc.localhost"
    },
    "windows": [
      {
        "label": "main",
        "title": "Git Khronos",
        "width": 1440,
        "height": 900,
        "minWidth": 780,
        "minHeight": 560,
        "center": true,
        "decorations": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Free, local-first Git client",
    "longDescription": "A fast, local-first desktop client for browsing Git history and managing\nrepositories without a required online account.\n\nReview changes, branches, and repository activity in a native visual workspace.",
    "homepage": "https://github.com/Git-Khronos/Git-Khronos",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "conflicts": [
          "git-khronos-desktop"
        ],
        "replaces": [
          "git-khronos-desktop"
        ],
        "depends": [
          "git (>= 1:2.39)",
          "libc6",
          "libssl3"
        ],
        "recommends": [
          "openssh-client",
          "git-lfs"
        ],
        "section": "vcs",
        "desktopTemplate": "../../../packaging/linux/git-khronos.desktop.hbs",
        "files": {
          "/usr/share/doc/git-khronos/copyright": "../../../packaging/debian/copyright",
          "/usr/share/doc/git-khronos/THIRD_PARTY_NOTICES.md": "../../../THIRD_PARTY_NOTICES.md",
          "/usr/share/doc/git-khronos/rust-dependency-notices.json.gz": "../../../target/package-assets/rust-dependency-notices.json.gz",
          "/usr/share/doc/git-khronos/frontend-dependency-notices.txt.gz": "../../../target/package-assets/frontend-dependency-notices.txt.gz",
          "/usr/share/doc/git-khronos/changelog.gz": "../../../target/package-assets/changelog.gz",
          "/usr/share/man/man1/git-khronos.1.gz": "../../../target/package-assets/git-khronos.1.gz"
        }
      },
      "rpm": {
        "depends": [
          "git-core >= 2.39"
        ],
        "recommends": [
          "openssh-clients",
          "git-lfs"
        ],
        "files": {
          "/usr/share/licenses/git-khronos/LICENSE": "../../../LICENSE",
          "/usr/share/doc/git-khronos/THIRD_PARTY_NOTICES.md": "../../../THIRD_PARTY_NOTICES.md",
          "/usr/share/doc/git-khronos/rust-dependency-notices.json.gz": "../../../target/package-assets/rust-dependency-notices.json.gz",
          "/usr/share/doc/git-khronos/frontend-dependency-notices.txt.gz": "../../../target/package-assets/frontend-dependency-notices.txt.gz"
        }
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "git-khronos"
        ]
      }
    }
  }
}
